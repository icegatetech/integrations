# Ollama, OpenAI-compatible surface
OPENAI_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:12b-mlx
# The OpenAI SDK requires a key; Ollama ignores its value.
OPENAI_API_KEY=ollama

# IceGate OTLP gRPC. 4317 is gRPC — never pair it with http/protobuf.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_SERVICE_NAME=openai-ollama-python

# Must be set before the process starts; read at instrumentation time.
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental

# Off by default: prompts and responses routinely contain PII.
# Enum, not boolean. Valid values: NO_CONTENT, SPAN_ONLY, EVENT_ONLY, SPAN_AND_EVENT
# (case-insensitive). true/false are invalid under gen_ai_latest_experimental — they
# log a warning and fall back to NO_CONTENT.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
